<!doctype html>
<html lang="en">
  <head>
    {{ include "partials/meta.vto" }}
  </head>
  <body>
    {{ include "partials/header.vto" }}
    {{# fullBleed drops the horizontal inset so banded sections can run edge to
        edge — brand.vto's brandSection wrapper carries the inset itself. #}}
    <main class="min-h-screen max-w-screen flex flex-col items-center gap-4 {{ fullBleed ? "" : "mx-8" }} mt-8 mb-24">
      {{ content }}
    </main>
    {{ include "partials/footer.vto" }}
  </body>
</html>