    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "^2.3.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.100.6",
    "camelcase-keys": "^10.0.2",
    "croner": "^10.0.1",
    "decamelize-keys": "^2.0.1",
    "expo": "~58.0.14",
    "expo-alarm-kit": "git+https://github.com/cvburgess/expo-alarm-kit.git#v0.2.0",
    "expo-asset": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
