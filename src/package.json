    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "private": true
