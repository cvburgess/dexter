{
  "name": "dexter",
  "main": "expo-router/entry",
  "version": "2.4.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "EXPO_UNSTABLE_WEB_MODAL=1 expo start",
    "dev:simulator": "eas build --platform ios --profile simulator",
    "dev:ios": "eas build --platform ios --profile development",
    "dev:android": "eas build --platform android --profile development",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "EXPO_UNSTABLE_WEB_MODAL=1 expo start --web",
    "export:web": "EXPO_UNSTABLE_WEB_MODAL=1 expo export --platform web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:types": "npx supabase gen types typescript --project-id \"isreileykodwkyedcewv\" --schema public > ./types/database.types.ts",
    "licenses": "node utils/generate-licenses.ts",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/flash-list"
      ]
    }
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/ui": "~58.0.20",
