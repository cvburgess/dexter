+  /// enclosing `Group` propagates through the environment to whichever `Menu`
+  /// branch above actually renders.
+  ///
+  /// Non-Catalyst builds return `self` untouched, so iOS and tvOS are unaffected.
+  @ViewBuilder
+  func plainMenuOnMacCatalyst() -> some View {
+#if targetEnvironment(macCatalyst)
+    self
+      .menuStyle(.button)
+      .buttonStyle(.plain)
+      .menuIndicator(.hidden)
+#else
+    self
+#endif
   }
 }
