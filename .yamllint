# Scopes the pi-lens yamllint lane to this repo. GitHub Actions workflows are
# machine-managed (no document marker) and routinely exceed 80 chars in
# expressions, so both defaults are relaxed; the `on:` key is a YAML truthy
# false positive.
extends: default
rules:
  document-start: disable
  line-length: disable
  truthy:
    check-keys: false
